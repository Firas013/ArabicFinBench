    title: "ExtractBench"
    abstract: "Schema-guided document extraction benchmark; upstream harness forked by ArabicFinBench."
    license: Apache-2.0
    repository-code: "https://github.com/run-llama/ExtractBench"
    authors:
      - name: "LlamaIndex (run-llama)"
